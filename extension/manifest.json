{
  "manifest_version": 3,
  "name": "SentinelX - Local URL Security Scanner & Threat Blocker",
  "version": "1.1.0",
  "description": "Zero-cost, local-only web security monitor. Provides pre-navigation blocking via declarativeNetRequest, phishing detection, and transparent security rules.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SentinelX Security Shield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_threats",
        "enabled": true,
        "path": "rules/rules.json"
      }
    ]
  },
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "dist/blocked.js",
        "dist/threat-manager.js",
        "blocked.css",
        "icons/icon-16.png",
        "icons/icon-48.png",
        "icons/icon-128.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
